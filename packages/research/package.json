{
  "name": "@summonghost/research",
  "version": "0.2.0",
  "description": "Shared research tools, bounded readers, and result pagination primitives",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferdousbhai/ghostkit.git",
    "directory": "packages/research"
  },
  "homepage": "https://github.com/ferdousbhai/ghostkit#readme",
  "bugs": {
    "url": "https://github.com/ferdousbhai/ghostkit/issues"
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/exa-search.ts",
    "src/pagination.ts",
