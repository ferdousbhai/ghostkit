{
  "name": "@summonghost/title-generation",
  "version": "0.1.1",
  "description": "Provider-neutral provisional and model-generated title helpers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferdousbhai/ghostkit.git",
    "directory": "packages/title-generation"
  },
  "homepage": "https://github.com/ferdousbhai/ghostkit#readme",
  "bugs": {
